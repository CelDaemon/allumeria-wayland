diff --git a/Allumeria/Audio/AudioPlayer.cs b/Allumeria/Audio/AudioPlayer.cs
index 797f4a9..518f8e0 100644
--- a/Allumeria/Audio/AudioPlayer.cs
+++ b/Allumeria/Audio/AudioPlayer.cs
@@ -67,7 +67,7 @@ public class AudioPlayer
 	public static void GetDevices()
 	{
 		soloud = new Soloud();
-		soloud.init(3u, 14u);
+		soloud.init(Soloud.CLIP_ROUNDOFF | Soloud.ENABLE_VISUALIZATION, Soloud.SDL2);
 		soloud.play(bus_main);
 		handle_music = bus_main.play(bus_music);
 		handle_ui = bus_main.play(bus_ui);
