From 8e02b9ab4d44c22c086113b3fac629a68d738161 Mon Sep 17 00:00:00 2001
From: CelDaemon <celdaemon@voidgroup.net>
Date: Mon, 7 Sep 2026 20:56:43 +0200
Subject: [PATCH 2/4] Fix wayland

---
 Allumeria/Game.cs | 13 ++++++++-----
 1 file changed, 8 insertions(+), 5 deletions(-)

diff --git a/Allumeria/Game.cs b/Allumeria/Game.cs
index b8c1e89..8860ed0 100644
--- a/Allumeria/Game.cs
+++ b/Allumeria/Game.cs
@@ -335,9 +335,9 @@ public class Game(int width, int height, string title) : GameWindow(GameWindowSe
 		Logger.Init("Starting extra loading thread");
 		SetupGame(new object());
 		Logger.Init("Creating main frame buffer");
-		gameBuffer.CreateFrameBuffer(base.ClientRectangle.Size.X, base.ClientRectangle.Size.Y, depth: true);
+		gameBuffer.CreateFrameBuffer(base.ClientSize.X, base.ClientSize.Y, depth: true);
 		Logger.Init("Creating water frame buffer");
-		waterBuffer.CreateFrameBuffer(base.ClientRectangle.Size.X, base.ClientRectangle.Size.Y, depth: true);
+		waterBuffer.CreateFrameBuffer(base.ClientSize.X, base.ClientSize.Y, depth: true);
 		_timer.Start();
 		Logger.Init("Particle system init");
 		ParticleSystem.Init();
@@ -385,6 +385,9 @@ public class Game(int width, int height, string title) : GameWindow(GameWindowSe
 
 	public void SetIcon()
 	{
+        if (GLFW.GetPlatform() == Platform.Wayland)
+            return;
+
 		using FileStream stream = File.OpenRead("res/textures/icon.png");
 		StbImage.stbi_set_flip_vertically_on_load(0);
 		ImageResult imageResult = ImageResult.FromStream(stream, StbImageSharp.ColorComponents.RedGreenBlueAlpha);
@@ -431,7 +434,7 @@ public class Game(int width, int height, string title) : GameWindow(GameWindowSe
 		{
 			camera.Update();
 		}
-		screenSize = base.ClientRectangle.Size;
+		screenSize = base.ClientSize;
 		TextureBatcher.batcher.ResetZDepth();
 		secondsElapsed += e.Time;
 		if (_timer.ElapsedMilliseconds > 1000)
@@ -615,8 +618,8 @@ public class Game(int width, int height, string title) : GameWindow(GameWindowSe
 	public static void ResetFrameBuffers()
 	{
 		gameBuffer.Unload();
-		Drawing.screenHeight = game.ClientRectangle.Size.Y;
-		Drawing.screenWidth = game.ClientRectangle.Size.X;
+		Drawing.screenHeight = game.ClientSize.Y;
+		Drawing.screenWidth = game.ClientSize.X;
 		gameBuffer.CreateFrameBuffer(Drawing.screenWidth / GameSettings.pixel_scale.value, Drawing.screenHeight / GameSettings.pixel_scale.value, depth: true);
 		Logger.Info($"Set Framebuffer: {Drawing.screenWidth / GameSettings.pixel_scale.value}");
 		waterBuffer.Unload();
-- 
